{
  "name": "studykarle-server",
  "version": "1.0.0",
  "description": "StudyKarle backend API - Express + PostgreSQL + Knex",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test:rate-limits": "node --test test/auth-rate-limits.test.js",
    "test:otp-email": "node --test test/otp-email.test.js",
    "dev": "nodemon server.js",
    "migrate": "node scripts/baseline-existing-migrations.js && knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback",
    "migrate:make": "knex migrate:make",
    "seed": "knex seed:run",
    "seed:make": "knex seed:make"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "1.4.6",
    "cors": "2.8.5",
    "dotenv": "^16.0.3",
    "express": "4.18.2",
    "express-rate-limit": "5.5.1",
    "express-validator": "6.14.3",
    "googleapis": "^105.0.0",
    "helmet": "4.6.0",
    "jsonwebtoken": "9.0.0",
    "knex": "2.4.2",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.1",
    "nodemailer": "^6.7.8",
    "pg": "^8.7.3",
    "resend": "^6.18.1"
  },
  "devDependencies": {
    "nodemon": "2.0.22"
  }
}
