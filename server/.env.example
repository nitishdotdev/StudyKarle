NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
# Comma-separated CORS allowlist (credentialed requests). Defaults to
# CLIENT_URL + localhost:5173. Must never be '*' for cookie auth.
# CORS_ORIGINS=https://studykarle.me,https://www.studykarle.me,https://studykarle.vercel.app

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=studykarle
DB_USER=postgres
DB_PASSWORD=postgres

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
COOKIE_NAME=studykarle_token

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-refresh-token
GOOGLE_REDIRECT_URI=http://localhost:5000/oauth2callback
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id

DRIVE_SYNC_INTERVAL_MS=0
DRIVE_SYNC_ON_START=true

RESEND_API_KEY=re_dummy_change_me
EMAIL_FROM=StudyKarle <onboarding@resend.dev>

# Trusted reverse-proxy hops for req.ip. Default 1. Raise only after
# PROXY_DIAGNOSTICS=true confirms distinct users share one ipHash.
# TRUST_PROXY_HOPS=1
# PROXY_DIAGNOSTICS=false

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=8
AUTH_IP_RATE_LIMIT_WINDOW_MS=900000
AUTH_IP_RATE_LIMIT_MAX=40
OTP_REQUEST_RATE_LIMIT_WINDOW_MS=900000
OTP_REQUEST_RATE_LIMIT_MAX=5
OTP_IP_RATE_LIMIT_WINDOW_MS=3600000
OTP_IP_RATE_LIMIT_MAX=20
SESSION_RATE_LIMIT_WINDOW_MS=60000
SESSION_RATE_LIMIT_MAX=120
SENSITIVE_RATE_LIMIT_WINDOW_MS=900000
SENSITIVE_RATE_LIMIT_MAX=5
